#!/usr/bin/env groovy

// This Jenkinsfile uses the internal VITO shared library

@Library('lib')_

properties([
  parameters([
    string(name: 'python_version', defaultValue: '3.11', description: 'Python version, e.g. 3.11 or 3.14')
  ])
])

def pythonVersion = params.python_version ?: '3.11'
def pythonVersionNoDot = pythonVersion.replace('.', '')

containerImageBuildPipeline {
  build_args            = [
    "OPENEO_BASE_IMAGE=openeo-docker-local-prod.repo.vito.be/openeo-base-python${pythonVersionNoDot}:latest",
  ]
  dockerfile            = 'docker/AlmaLinux/Dockerfile.openeo-geotrellis-kube-azure'
  docker_registry_prod  = 'swr.eu-nl.otc.t-systems.com/openeo'
  credentials_id        = 'openeo_swr_otc'
  downstream_jobs       = []
  image_name            = "openeo-geotrellis-kube-azure-python${pythonVersionNoDot}"
  promotion_job         = false
  run_tests             = false
  oci_format            = true
  extra_index_repo      = 'openeo-pypi'
  pip_index_server      = 'sas'
  artifactory_server    = 'sas'
}
