ARG PYTHON_VERSION=3.14
ARG GDAL_VERSION=3.13.3
ARG GROK_VERSION=20.4.24
ARG SPARK_VERSION=4.3.0
ARG BASE_IMAGE=docker.io/library/almalinux:10.2

########## grok ##########
FROM ${BASE_IMAGE} AS grok-build
ARG GROK_VERSION

RUN dnf install -y epel-release && \
    dnf --enablerepo=crb install -y \
        gcc gcc-c++ cmake ninja-build git \
        libtiff-devel libpng-devel libjpeg-turbo-devel lcms2-devel zlib-devel

RUN mkdir -p /src/grok && \
    curl -L https://github.com/GrokImageCompression/grok/releases/download/v${GROK_VERSION}/source-full.tar.gz \
        | tar xz --strip-components=1 -C /src/grok && \
    cmake -S /src/grok -B /src/grok-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DGRK_BUILD_JPEG=OFF -DGRK_BUILD_LIBPNG=OFF -DGRK_BUILD_LIBTIFF=OFF -DGRK_BUILD_LCMS2=OFF \
        -DGRK_BUILD_CORE_SWIG_BINDINGS=OFF -DGRK_BUILD_CORE_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF && \
    cmake --build /src/grok-build && \
    DESTDIR=/grok-install cmake --install /src/grok-build

########## builder ##########
FROM ${BASE_IMAGE} AS gdal-build
ARG GDAL_VERSION

COPY --from=grok-build /grok-install/usr/ /usr/

RUN dnf install -y epel-release && \
    dnf --enablerepo=crb install -y \
        gcc gcc-c++ cmake ninja-build git \
        geos-devel sqlite-devel libtiff-devel libcurl-devel \
        libpng-devel libjpeg-turbo-devel libwebp-devel libzstd-devel \
        hdf5-devel netcdf-devel expat-devel xerces-c-devel openjpeg2-devel \
        lcms2-devel sqlite

RUN mkdir -p /src
ARG PROJ_VERSION=9.9.0
RUN curl -L https://download.osgeo.org/proj/proj-${PROJ_VERSION}.tar.gz | tar xz -C /src && \
    cmake -S /src/proj-${PROJ_VERSION} -B /src/proj-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/gdal \
        -DBUILD_TESTING=OFF -DBUILD_APPS=ON \
        -DENABLE_CURL=ON -DENABLE_TIFF=ON && \
    cmake --build /src/proj-build && cmake --install /src/proj-build

# GDAL (C/C++ only; the Python bindings get built later against the venv)
RUN curl -L https://github.com/OSGeo/gdal/releases/download/v${GDAL_VERSION}/gdal-${GDAL_VERSION}.tar.gz \
        | tar xz -C /src && \
    cmake -S /src/gdal-${GDAL_VERSION} -B /src/gdal-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/gdal \
        -DCMAKE_PREFIX_PATH=/opt/gdal \
        -DGDAL_USE_GROK=ON \
        -DGDAL_USE_OPENJPEG=ON \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_TESTING=OFF && \
    cmake --build /src/gdal-build && cmake --install /src/gdal-build

########## runtime ##########
FROM ${BASE_IMAGE}
ARG PYTHON_VERSION
ARG GDAL_VERSION
# ... existing ARGs / dnf install, without the gdal* and python3.11* packages,
#     plus the runtime libs: proj geos hdf5 netcdf libtiff libwebp xerces-c openjpeg2 ...

COPY --from=gdal-build /opt/gdal /opt/gdal
COPY --from=grok-build /grok-install/usr/ /usr/
RUN echo /opt/gdal/lib64 > /etc/ld.so.conf.d/gdal.conf && \
    echo /opt/gdal/lib  >> /etc/ld.so.conf.d/gdal.conf && ldconfig
ENV PATH=/opt/gdal/bin:$PATH \
    GDAL_DATA=/opt/gdal/share/gdal \
    PROJ_DATA=/opt/gdal/share/proj \
    LIBRARY_PATH=/opt/gdal/lib64:/opt/gdal/lib \
    CPATH=/opt/gdal/include

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_PYTHON_INSTALL_DIR=/opt/python VIRTUAL_ENV=/opt/venv
RUN uv python install ${PYTHON_VERSION} && \
    uv venv --python ${PYTHON_VERSION} ${VIRTUAL_ENV}
ENV PATH=${VIRTUAL_ENV}/bin:$PATH PYSPARK_PYTHON=${VIRTUAL_ENV}/bin/python


ARG TINI_VERSION=v0.19.0
ARG SPARK_VERSION
ARG SPARK_DOWNLOAD_URL=https://dlcdn.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz
ARG GEOTRELLIS_DEPENDENCIES_STATIC_JAR_URL

WORKDIR /opt/spark/work-dir

COPY docker/AlmaLinux/vito_almalinux9.repo /etc/yum.repos.d/vito.repo
ADD https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini /usr/bin/tini

RUN dnf clean all && \
    dnf install -y epel-release && \
    dnf --enablerepo=crb install -y \
        glibc-langpack-en \
        hdf5 \
        gcc-c++ \
        unzip \
        java-25-openjdk-headless \
        krb5-workstation \
        krb5-libs \
        sssd-client \
        ipa-client \
        nss \
        boost-filesystem \
        boost-serialization \
        procps-ng \
        fftw-libs-double \
        fftw-libs-single \
        tinyxml \
        udunits2 \
        libtiff-tools \
        blosc \
        libgfortran \
        jemalloc \
        openeo-vito-aux-data \
        geos netcdf libtiff libpng \
        libjpeg-turbo libwebp libzstd expat xerces-c \
        openjpeg2 lcms2 sqlite-libs \
        && \
    chmod +x /usr/bin/tini && \
    rm -r /root/.cache && \
    yum clean all && \
    rm -rf /var/cache/yum/*

# Spire is removed because of version mismatch with geotrellis! Spark only has a minimal dependency on it, in a part that we do not use.
# yarn and R are removed to save space.
RUN mkdir -p /usr/local/spark && \
    curl -fL ${SPARK_DOWNLOAD_URL} | tar xz --strip-components=1 -C /usr/local/spark && \
    rm -rf /usr/local/spark/jars/spire* /usr/local/spark/yarn /usr/local/spark/R

# Bindings: numpy must be installed first so gdal_array gets built.
# gcc-c++ is needed in this stage (it's already in your dnf list).
RUN uv pip install pip numpy setuptools wheel cython && \
    uv pip install --no-build-isolation --no-binary GDAL "GDAL==${GDAL_VERSION}" && \
    python -c "from osgeo import gdal; print(gdal.__version__)"

#gdalwarp is compiled against libgdal.so.38,
RUN ln -s /opt/gdal/lib64/libgdal.so /usr/lib64/libgdal.so.38


# Required for new hadoop cluster because this causes "/var/lib/sss/pubconf/krb5.include.d" to be included twice which throws an error.
RUN rm /etc/krb5.conf.d/enable_sssd_conf_dir


ENV SPARK_HOME /usr/local/spark
ENV JAVA_HOME /usr/lib/jvm/jre
ENV HADOOP_HOME=/usr/hdp/current/hadoop-client
ENV HADOOP_CONF_DIR=/etc/hadoop/conf
ENV YARN_CONF_DIR=/etc/hadoop/conf
ENV OTB_HOME=/usr
ENV OTB_APPLICATION_PATH=/usr/lib/otb/applications

ADD $GEOTRELLIS_DEPENDENCIES_STATIC_JAR_URL /opt/geotrellis-dependencies-static.jar
RUN chmod 755 /opt/geotrellis-dependencies-static.jar
