    'PYTHON_VERSION=3.14',
    'GEOTRELLIS_DEPENDENCIES_STATIC_JAR_URL=https://repo.vito.be/artifactory/openeo-maven-snapshot-local/org/openeo/geotrellis-dependencies/2.6.3_2.13-SNAPSHOT/geotrellis-dependencies-2.6.3_2.13-SNAPSHOT.jar',
